# =====================================================================
# KOFINEX — variables d'environnement
# Copier en `.env` (racine) et `frontend/.env.local`. Ne jamais committer.
# =====================================================================

# ---------- Environnement ----------
APP_ENV=development                 # development | staging | production
APP_NAME="KOFINEX"
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# ---------- Base de données ----------
# Supabase : Project Settings > Database > Connection string (mode session, port 5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kofinex
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Clé service role : backend uniquement, JAMAIS exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Vérification JWT : soit le secret HS256 (Settings > API > JWT Secret)...
SUPABASE_JWT_SECRET=
# ...soit les clés asymétriques (laisser vide pour utiliser HS256)
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET_DOCUMENTS=financial-documents
SUPABASE_STORAGE_BUCKET_REPORTS=reports

# ---------- Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Fichiers ----------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=xlsx,xls,csv,pdf

# ---------- Sécurité ----------
# Clé Fernet pour chiffrer les identifiants des intégrations :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=

# ---------- IA ----------
AI_PROVIDER=none                    # anthropic | openai | none (aucune IA tant que la clé et le modèle ne sont pas fournis)
AI_API_KEY=
AI_MODEL=                           # identifiant exact du modèle chez le fournisseur choisi
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=60
AI_BASE_URL=                        # facultatif (passerelle d'entreprise)

# ---------- Frontend (préfixe NEXT_PUBLIC_ = visible côté navigateur) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------- Importation ----------
STORAGE_BACKEND=supabase            # supabase | local (développement uniquement)
LOCAL_STORAGE_DIR=./.storage
IMPORT_PROCESSING=celery            # celery | inline (développement / tests)
OCR_LANGUAGE=fra                    # langue Tesseract (paquet tesseract-ocr-fra)
